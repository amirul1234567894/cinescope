# ─── TMDB API ──────────────────────────────────────────────────────────────
# Get your key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# ─── YOUTUBE DATA API v3 ────────────────────────────────────────────────────
# Get at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── SUPABASE ───────────────────────────────────────────────────────────────
# Get at: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── OPTIONAL: NEWS API ─────────────────────────────────────────────────────
# Get at: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# ─── OPTIONAL: WATCHMODE API (OTT availability) ─────────────────────────────
# Get at: https://api.watchmode.com
WATCHMODE_API_KEY=your_watchmode_api_key_here

# ─── OPTIONAL: OPENAI (AI recommendations) ──────────────────────────────────
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── OPTIONAL: ALGOLIA (ultra-fast search) ──────────────────────────────────
# Get at: https://www.algolia.com
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id_here
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_key_here
ALGOLIA_ADMIN_KEY=your_algolia_admin_key_here

# ─── SITE CONFIG ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cinescope.vercel.app
NEXT_PUBLIC_SITE_NAME=CineScope
NEXT_PUBLIC_TMDB_ATTRIBUTION=This product uses the TMDb API but is not endorsed or certified by TMDb.

# ─── SEO ────────────────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=your_google_verification_token_here

# ─── N8N AUTOMATION ─────────────────────────────────────────────────────────
# Your n8n instance webhook secret (for secure webhook calls)
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# ─── ADMIN ──────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=your_admin_secret_key_here
CRON_SECRET=your_cron_job_secret_here
